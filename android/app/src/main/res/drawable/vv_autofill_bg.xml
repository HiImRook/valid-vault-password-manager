<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#59000000" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#F4F6F8" android:endColor="#8A9098" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2D3238" android:endColor="#1A1D21" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
