<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#59000000" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#F4F6F8" android:endColor="#8A9098" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#16181B" android:endColor="#22262B" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#59000000" android:centerColor="#00000000" android:centerY="0.22" android:endColor="#00000000" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</layer-list>
