<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vv_widget_search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/vv_widget_day_bg"
        android:paddingBottom="3dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="1.5dp"
                android:paddingBottom="1.5dp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="normal"
                android:maxLines="1"
                android:text="@string/vv_search_privately"
                android:textColor="#40000000"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="0.75dp"
                android:paddingTop="0.75dp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="normal"
                android:maxLines="1"
                android:text="@string/vv_search_privately"
                android:textColor="#2A2C30"
                android:textSize="16sp"
                android:shadowColor="#CCFFFFFF"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1" />

        </FrameLayout>

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/vv_search_privately"
            android:src="@drawable/vv_wic_search_day" />

    </FrameLayout>

    <ImageView
        android:id="@+id/vv_widget_bookmarks"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="start|center_vertical"
        android:padding="12dp"
        android:contentDescription="@string/vv_widget_bookmarks"
        android:src="@drawable/vv_wic_bookmark_day" />

</FrameLayout>
